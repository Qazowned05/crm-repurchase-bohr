<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CRM" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:collaboration id="Collaboration_CRM">
    <bpmn:participant id="Participant_Setup" name="Configuracion y datos" processRef="Process_Setup" />
    <bpmn:participant id="Participant_Sales" name="Registro de ventas" processRef="Process_Sales" />
    <bpmn:participant id="Participant_Alerts" name="Alertas y seguimiento" processRef="Process_Alerts" />
    <bpmn:messageFlow id="Message_SaleConfirmed" name="Venta confirmada" sourceRef="Task_ConfirmSale" targetRef="Task_IdentifySales" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Setup" name="Configuracion y carga inicial" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_Setup_1" sourceRef="Start_Setup" targetRef="Task_Users" />
    <bpmn:sequenceFlow id="Flow_Setup_2" sourceRef="Task_Users" targetRef="Task_Settings" />
    <bpmn:sequenceFlow id="Flow_Setup_3" sourceRef="Task_Settings" targetRef="Task_Products" />
    <bpmn:sequenceFlow id="Flow_Setup_4" sourceRef="Task_Products" targetRef="Task_Import" />
    <bpmn:sequenceFlow id="Flow_Setup_5" sourceRef="Task_Import" targetRef="End_Setup" />
    <bpmn:startEvent id="Start_Setup" name="Inicio">
      <bpmn:outgoing>Flow_Setup_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Users" name="Crear usuarios, roles y administrador inicial">
      <bpmn:incoming>Flow_Setup_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Setup_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Settings" name="Definir parametros de alertas y recuperacion">
      <bpmn:incoming>Flow_Setup_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Setup_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Products" name="Configurar productos y reglas de vencimientos">
      <bpmn:incoming>Flow_Setup_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Setup_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Import" name="Importar clientes y productos desde Excel">
      <bpmn:incoming>Flow_Setup_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Setup_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Setup" name="Base comercial lista">
      <bpmn:incoming>Flow_Setup_5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Sales" name="Registro y validacion de ventas" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_Sale_1" sourceRef="Start_Sale" targetRef="Task_Login" />
    <bpmn:sequenceFlow id="Flow_Sale_2" sourceRef="Task_Login" targetRef="Task_SearchCustomer" />
    <bpmn:sequenceFlow id="Flow_Sale_3" sourceRef="Task_SearchCustomer" targetRef="Gateway_CustomerExists" />
    <bpmn:sequenceFlow id="Flow_Customer_No" name="No" sourceRef="Gateway_CustomerExists" targetRef="Task_CreateCustomer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">cliente_no_encontrado</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Customer_Yes" name="Si" sourceRef="Gateway_CustomerExists" targetRef="Gateway_CustomerJoin" />
    <bpmn:sequenceFlow id="Flow_Customer_CreateJoin" sourceRef="Task_CreateCustomer" targetRef="Gateway_CustomerJoin" />
    <bpmn:sequenceFlow id="Flow_Sale_4" sourceRef="Gateway_CustomerJoin" targetRef="Task_RegisterSale" />
    <bpmn:sequenceFlow id="Flow_Sale_5" sourceRef="Task_RegisterSale" targetRef="Gateway_FirstSale" />
    <bpmn:sequenceFlow id="Flow_FirstSale_Yes" name="Si" sourceRef="Gateway_FirstSale" targetRef="Task_CaptureSource">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">primera_venta_cliente</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FirstSale_No" name="No" sourceRef="Gateway_FirstSale" targetRef="Gateway_SourceJoin" />
    <bpmn:sequenceFlow id="Flow_SourceJoin" sourceRef="Task_CaptureSource" targetRef="Gateway_SourceJoin" />
    <bpmn:sequenceFlow id="Flow_Sale_6" sourceRef="Gateway_SourceJoin" targetRef="Task_ApplyRules" />
    <bpmn:sequenceFlow id="Flow_Sale_7" sourceRef="Task_ApplyRules" targetRef="Gateway_Duplicate" />
    <bpmn:sequenceFlow id="Flow_Duplicate_Yes" name="Si" sourceRef="Gateway_Duplicate" targetRef="Task_ReviewDuplicate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">posible_duplicado</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Duplicate_No" name="No" sourceRef="Gateway_Duplicate" targetRef="Gateway_DuplicateJoin" />
    <bpmn:sequenceFlow id="Flow_Duplicate_Join" sourceRef="Task_ReviewDuplicate" targetRef="Gateway_DuplicateJoin" />
    <bpmn:sequenceFlow id="Flow_Sale_8" sourceRef="Gateway_DuplicateJoin" targetRef="Task_ConfirmSale" />
    <bpmn:sequenceFlow id="Flow_Sale_9" sourceRef="Task_ConfirmSale" targetRef="End_Sale" />
    <bpmn:startEvent id="Start_Sale" name="Asesor inicia venta">
      <bpmn:outgoing>Flow_Sale_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Login" name="Iniciar sesion">
      <bpmn:incoming>Flow_Sale_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Sale_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SearchCustomer" name="Buscar cliente por DNI">
      <bpmn:incoming>Flow_Sale_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Sale_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CustomerExists" name="Cliente existe?" default="Flow_Customer_Yes">
      <bpmn:incoming>Flow_Sale_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Customer_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Customer_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CreateCustomer" name="Crear cliente">
      <bpmn:incoming>Flow_Customer_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Customer_CreateJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CustomerJoin" name="Cliente disponible">
      <bpmn:incoming>Flow_Customer_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Customer_CreateJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Sale_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RegisterSale" name="Registrar venta, productos y cantidades">
      <bpmn:incoming>Flow_Sale_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Sale_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_FirstSale" name="Primera venta del cliente?" default="Flow_FirstSale_No">
      <bpmn:incoming>Flow_Sale_5</bpmn:incoming>
      <bpmn:outgoing>Flow_FirstSale_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_FirstSale_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CaptureSource" name="Registrar canal: TV, DIGITAL u OTROS">
      <bpmn:incoming>Flow_FirstSale_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_SourceJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SourceJoin" name="Venta preparada">
      <bpmn:incoming>Flow_FirstSale_No</bpmn:incoming>
      <bpmn:incoming>Flow_SourceJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Sale_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ApplyRules" name="Copiar reglas vigentes y clasificar compra o recompra">
      <bpmn:incoming>Flow_Sale_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Sale_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Duplicate" name="Posible venta duplicada?" default="Flow_Duplicate_No">
      <bpmn:incoming>Flow_Sale_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Duplicate_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Duplicate_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReviewDuplicate" name="Supervisor revisa y aprueba excepcion">
      <bpmn:incoming>Flow_Duplicate_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Duplicate_Join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_DuplicateJoin" name="Venta validada">
      <bpmn:incoming>Flow_Duplicate_No</bpmn:incoming>
      <bpmn:incoming>Flow_Duplicate_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Sale_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ConfirmSale" name="Confirmar venta y actualizar historial">
      <bpmn:incoming>Flow_Sale_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Sale_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Sale" name="Venta confirmada">
      <bpmn:incoming>Flow_Sale_9</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Alerts" name="Ciclo diario de alertas y seguimiento" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_Alert_1" sourceRef="Start_Daily" targetRef="Task_IdentifySales" />
    <bpmn:sequenceFlow id="Flow_Alert_2" sourceRef="Task_IdentifySales" targetRef="Task_CreateAlerts" />
    <bpmn:sequenceFlow id="Flow_Alert_3" sourceRef="Task_CreateAlerts" targetRef="Gateway_Assignee" />
    <bpmn:sequenceFlow id="Flow_Assignee_Yes" name="Si" sourceRef="Gateway_Assignee" targetRef="Task_AssignAdvisor" />
    <bpmn:sequenceFlow id="Flow_Assignee_No" name="No" sourceRef="Gateway_Assignee" targetRef="Task_RecoveryQueue" />
    <bpmn:sequenceFlow id="Flow_AssignJoin" sourceRef="Task_AssignAdvisor" targetRef="Gateway_AssignJoin" />
    <bpmn:sequenceFlow id="Flow_Alert_4" sourceRef="Gateway_AssignJoin" targetRef="Task_Inbox" />
    <bpmn:sequenceFlow id="Flow_Alert_5" sourceRef="Task_Inbox" targetRef="Task_Contact" />
    <bpmn:sequenceFlow id="Flow_Alert_6" sourceRef="Task_Contact" targetRef="Gateway_Outcome" />
    <bpmn:sequenceFlow id="Flow_Outcome_Repurchase" name="Recompra" sourceRef="Gateway_Outcome" targetRef="Task_RecordRepurchase" />
    <bpmn:sequenceFlow id="Flow_Outcome_FollowUp" name="Aun tiene producto o solicita seguimiento" sourceRef="Gateway_Outcome" targetRef="Task_Reprogram" />
    <bpmn:sequenceFlow id="Flow_Outcome_NoAnswer" name="Sin respuesta" sourceRef="Gateway_Outcome" targetRef="Gateway_MaxAttempts" />
    <bpmn:sequenceFlow id="Flow_Outcome_NoInterest" name="No interesado" sourceRef="Gateway_Outcome" targetRef="Task_CloseNoInterest" />
    <bpmn:sequenceFlow id="Flow_Outcome_InvalidData" name="Datos incorrectos" sourceRef="Gateway_Outcome" targetRef="Task_RecoveryQueue" />
    <bpmn:sequenceFlow id="Flow_Repurchase_1" sourceRef="Task_RecordRepurchase" targetRef="Task_CloseRepurchase" />
    <bpmn:sequenceFlow id="Flow_Repurchase_2" sourceRef="Task_CloseRepurchase" targetRef="End_Repurchase" />
    <bpmn:sequenceFlow id="Flow_FollowUp_End" sourceRef="Task_Reprogram" targetRef="End_Reprogrammed" />
    <bpmn:sequenceFlow id="Flow_MaxAttempts_Yes" name="Si" sourceRef="Gateway_MaxAttempts" targetRef="Task_RecoveryQueue" />
    <bpmn:sequenceFlow id="Flow_MaxAttempts_No" name="No" sourceRef="Gateway_MaxAttempts" targetRef="Task_ScheduleRetry" />
    <bpmn:sequenceFlow id="Flow_Retry_End" sourceRef="Task_ScheduleRetry" targetRef="End_Retry" />
    <bpmn:sequenceFlow id="Flow_NoInterest_End" sourceRef="Task_CloseNoInterest" targetRef="End_NoInterest" />
    <bpmn:sequenceFlow id="Flow_Recovery_End" sourceRef="Task_RecoveryQueue" targetRef="End_Recovery" />
    <bpmn:startEvent id="Start_Daily" name="Proceso diario">
      <bpmn:outgoing>Flow_Alert_1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Daily" />
    </bpmn:startEvent>
    <bpmn:task id="Task_IdentifySales" name="Identificar productos proximos a recompra">
      <bpmn:incoming>Flow_Alert_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Alert_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CreateAlerts" name="Crear alertas sin duplicados por producto">
      <bpmn:incoming>Flow_Alert_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Alert_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Assignee" name="Responsable activo?" default="Flow_Assignee_Yes">
      <bpmn:incoming>Flow_Alert_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Assignee_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Assignee_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_AssignAdvisor" name="Asignar al responsable actual del cliente">
      <bpmn:incoming>Flow_Assignee_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_AssignJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RecoveryQueue" name="Enviar a cola de recuperacion">
      <bpmn:incoming>Flow_Assignee_No</bpmn:incoming>
      <bpmn:incoming>Flow_MaxAttempts_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Outcome_InvalidData</bpmn:incoming>
      <bpmn:outgoing>Flow_Recovery_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AssignJoin" name="Alerta disponible">
      <bpmn:incoming>Flow_AssignJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Alert_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Inbox" name="Asesor revisa bandeja priorizada">
      <bpmn:incoming>Flow_Alert_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Alert_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Contact" name="Registrar gestion y tipificacion">
      <bpmn:incoming>Flow_Alert_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Alert_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Outcome" name="Resultado de gestion?">
      <bpmn:incoming>Flow_Alert_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Outcome_Repurchase</bpmn:outgoing>
      <bpmn:outgoing>Flow_Outcome_FollowUp</bpmn:outgoing>
      <bpmn:outgoing>Flow_Outcome_NoAnswer</bpmn:outgoing>
      <bpmn:outgoing>Flow_Outcome_NoInterest</bpmn:outgoing>
      <bpmn:outgoing>Flow_Outcome_InvalidData</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RecordRepurchase" name="Registrar recompra desde la alerta">
      <bpmn:incoming>Flow_Outcome_Repurchase</bpmn:incoming>
      <bpmn:outgoing>Flow_Repurchase_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CloseRepurchase" name="Cerrar alerta origen y cancelar alertas relacionadas">
      <bpmn:incoming>Flow_Repurchase_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Repurchase_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Reprogram" name="Reprogramar proxima accion">
      <bpmn:incoming>Flow_Outcome_FollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUp_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_MaxAttempts" name="Supera intentos o atraso maximo?" default="Flow_MaxAttempts_No">
      <bpmn:incoming>Flow_Outcome_NoAnswer</bpmn:incoming>
      <bpmn:outgoing>Flow_MaxAttempts_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_MaxAttempts_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ScheduleRetry" name="Programar siguiente intento">
      <bpmn:incoming>Flow_MaxAttempts_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Retry_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CloseNoInterest" name="Cerrar como no interesado">
      <bpmn:incoming>Flow_Outcome_NoInterest</bpmn:incoming>
      <bpmn:outgoing>Flow_NoInterest_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Repurchase" name="Recompra lograda">
      <bpmn:incoming>Flow_Repurchase_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Reprogrammed" name="Seguimiento reprogramado">
      <bpmn:incoming>Flow_FollowUp_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Retry" name="Pendiente de nuevo intento">
      <bpmn:incoming>Flow_Retry_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_NoInterest" name="Seguimiento cerrado">
      <bpmn:incoming>Flow_NoInterest_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Recovery" name="Pendiente de reasignacion">
      <bpmn:incoming>Flow_Recovery_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CRM">
    <bpmndi:BPMNPlane id="Plane_CRM" bpmnElement="Collaboration_CRM">
      <bpmndi:BPMNShape id="Participant_Setup_di" bpmnElement="Participant_Setup" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="1950" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Setup_di" bpmnElement="Start_Setup">
        <dc:Bounds x="215" y="105" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="220" y="141" width="26" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Users_di" bpmnElement="Task_Users">
        <dc:Bounds x="300" y="83" width="230" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Settings_di" bpmnElement="Task_Settings">
        <dc:Bounds x="580" y="83" width="240" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Products_di" bpmnElement="Task_Products">
        <dc:Bounds x="870" y="83" width="270" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Import_di" bpmnElement="Task_Import">
        <dc:Bounds x="1190" y="83" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Setup_di" bpmnElement="End_Setup">
        <dc:Bounds x="1500" y="105" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1480" y="141" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Sales_di" bpmnElement="Participant_Sales" isHorizontal="true">
        <dc:Bounds x="160" y="250" width="2600" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Sale_di" bpmnElement="Start_Sale">
        <dc:Bounds x="215" y="365" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="202" y="401" width="63" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Login_di" bpmnElement="Task_Login">
        <dc:Bounds x="300" y="343" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SearchCustomer_di" bpmnElement="Task_SearchCustomer">
        <dc:Bounds x="470" y="343" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CustomerExists_di" bpmnElement="Gateway_CustomerExists" isMarkerVisible="true">
        <dc:Bounds x="690" y="358" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="679" y="408" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateCustomer_di" bpmnElement="Task_CreateCustomer">
        <dc:Bounds x="790" y="275" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CustomerJoin_di" bpmnElement="Gateway_CustomerJoin" isMarkerVisible="true">
        <dc:Bounds x="990" y="358" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="972" y="408" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegisterSale_di" bpmnElement="Task_RegisterSale">
        <dc:Bounds x="1090" y="343" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_FirstSale_di" bpmnElement="Gateway_FirstSale" isMarkerVisible="true">
        <dc:Bounds x="1340" y="358" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1322" y="408" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CaptureSource_di" bpmnElement="Task_CaptureSource">
        <dc:Bounds x="1440" y="275" width="220" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SourceJoin_di" bpmnElement="Gateway_SourceJoin" isMarkerVisible="true">
        <dc:Bounds x="1710" y="358" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1694" y="408" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApplyRules_di" bpmnElement="Task_ApplyRules">
        <dc:Bounds x="1810" y="343" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Duplicate_di" bpmnElement="Gateway_Duplicate" isMarkerVisible="true">
