# Copy outside the repository, set file permissions to owner-read/write, and populate values there.
APP_ENV=production
APP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql+psycopg://crm:replace-with-url-encoded-password@db:5432/crm_fidelizacion
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-before-first-start
CORS_ORIGINS=https://crm.example.com
ALERT_ACTIVE_WINDOW_DAYS=30

# Compose interpolation variables. Keep this file protected and out of version control.
POSTGRES_DB=crm_fidelizacion
POSTGRES_USER=crm
POSTGRES_PASSWORD=replace-with-a-long-random-password
BACKUP_HOST_PATH=/srv/crm-fidelizacion/backups
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
APP_ENV_FILE=/srv/crm-fidelizacion/.env.production
